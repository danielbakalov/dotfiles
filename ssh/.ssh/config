Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes
Host remote.eos.ncsu.edu
    User dbbakalo
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 12h
    PubkeyAuthentication no

# NC State managed GitHub account (dbbakalo_ncstate)
Host github-ncstate
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ncstate
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes
